{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "builds": [
    {
      "src": "api/create-payment.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/check-status.js",
      "use": "@vercel/node"
    },
    {
      "src": "checkout.html",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "order-confirmation.html",
      "use": "@vercel/static"
    },
    {
      "src": "admin.html",
      "use": "@vercel/static"
    },
    {
      "src": "live-admin.html",
      "use": "@vercel/static"
    },
    {
      "src": "product.html",
      "use": "@vercel/static"
    },
    {
      "src": "about-us.html",
      "use": "@vercel/static"
    },
    {
      "src": "account.html",
      "use": "@vercel/static"
    },
    {
      "src": "collections.html",
      "use": "@vercel/static"
    },
    {
      "src": "contact-information.html",
      "use": "@vercel/static"
    },
    {
      "src": "privacy-policy.html",
      "use": "@vercel/static"
    },
    {
      "src": "refund-policy.html",
      "use": "@vercel/static"
    },
    {
      "src": "shipping-policy.html",
      "use": "@vercel/static"
    },
    {
      "src": "terms-of-service.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "app-core.js",
      "use": "@vercel/static"
    },
    {
      "src": "products.json",
      "use": "@vercel/static"
    },
    {
      "src": "settings.json",
      "use": "@vercel/static"
    },
    {
      "src": "Image/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/create-payment",
      "dest": "api/create-payment.js"
    },
    {
      "src": "/api/check-status",
      "dest": "api/check-status.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
