{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "app-core.js",
      "use": "@vercel/static"
    },
    {
      "src": "products.json",
      "use": "@vercel/static"
    },
    {
      "src": "settings.json",
      "use": "@vercel/static"
    },
    {
      "src": "Image/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/create-payment",
      "dest": "api/create-payment.js"
    },
    {
      "src": "/api/check-status",
      "dest": "api/check-status.js"
    },
    {
      "src": "/api/track-purchase",
      "dest": "api/track-purchase.js"
    },
    {
      "handle": "filesystem"
    }
  ]
}
